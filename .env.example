APP_NAME=AppsDev API Tutorial
PORT=7000
NODE_ENV=development
# Generate a strong secret: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_random_secret
BACKEND_URL=http://localhost:7000
FRONTEND_URL=http://localhost:5173
# Use a different random value than JWT_SECRET
CSRF_SECRET=replace_with_a_separate_random_secret
DATABASE_URL=postgresql://user:password@localhost:5432/recipe_book
